@model Almisbah_library.Models.Book
@{
    ViewBag.Title = "تعديل كتاب";
}

<h2>تعديل كتاب</h2>
@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.Id)
    <div class="form-group">اسم الكتاب: @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })</div>
    <div class="form-group">المؤلف: @Html.TextBoxFor(m => m.Authur, new { @class = "form-control" })</div>
    <div class="form-group">السعر: @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })</div>
    <div class="form-group">الكمية: @Html.TextBoxFor(m => m.Stock, new { @class = "form-control" })</div>
    <br />
    <button type="submit" class="btn btn-success">💾 حفظ التعديل</button>
    <a href="/Book" class="btn btn-default">رجوع</a>

}